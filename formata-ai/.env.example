# Formata.AI Web — variáveis de ambiente. Todas são opcionais.
# Comentários ficam em linhas próprias: "docker --env-file" não aceita comentário no fim da linha.
# Linhas comentadas mostram o valor padrão.

# --- Rede (no contêiner, o Dockerfile já define 0.0.0.0:8000) ---
# FORMATA_HOST=127.0.0.1
# FORMATA_PORTA=8000
# Processos uvicorn; cada um atende várias requisições.
# FORMATA_WORKERS=1

# --- Limites de entrada e de processamento ---
# Tamanho máximo do documento em UTF-8, em bytes (1 MB).
FORMATA_LIMITE_BYTES=1048576
# Linhas ou parágrafos <p> por documento.
FORMATA_LIMITE_LINHAS=20000
# Segundos por formatação; ao estourar, o processo da formatação é encerrado.
FORMATA_TEMPO_LIMITE=15
# Formatações simultâneas por worker (padrão: número de CPUs).
# FORMATA_MAX_PROCESSOS=4
# "processo" (recomendado) ou "direto" (sem processo filho; só para testes).
FORMATA_ISOLAMENTO=processo

# --- Interface e integração ---
# Pasta da landing page (padrão: ../frontend). Pasta inexistente = só a API.
# FORMATA_FRONTEND_DIR=/app/frontend
# Origens autorizadas, separadas por vírgula, se a interface ficar em outro domínio.
# FORMATA_ORIGENS_CORS=https://formata.exemplo.com.br
# 0 desativa /api/docs e /api/openapi.json.
FORMATA_DOCS_API=1

# --- Registro técnico (nunca inclui o conteúdo dos documentos) ---
FORMATA_LOG_NIVEL=INFO
